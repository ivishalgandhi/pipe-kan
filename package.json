{
  "name": "pipe-kan",
  "version": "0.18.0",
  "description": "Local Kanban for jira-cli",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pipe-kan": "dist/pipe-kan.js"
  },
  "files": [
    "dist/pipe-kan.js",
    "dist/ui",
    "fixtures/issues.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivishalgandhi/pipe-kan.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun src/start.ts",
    "start": "bun src/bin.ts",
    "build": "vite build && bun build src/bin.ts --outfile dist/pipe-kan.js --target node --banner '#!/usr/bin/env node'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "tailwind-merge": "^3.6.0"
  }
}
